{
  "expo": {
    "name": "Gym Tracker",
    "slug": "gym-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "gymtracker",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#181825"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.laingventures.gymtracker",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to scan Matrix equipment QR codes"
      }
    },
    "android": {
      "package": "com.laingventures.gymtracker",
      "permissions": ["CAMERA"]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Used to scan Matrix equipment QR codes"
        }
      ]
    ]
  }
}
